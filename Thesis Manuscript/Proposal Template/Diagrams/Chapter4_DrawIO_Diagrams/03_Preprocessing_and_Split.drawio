<mxfile host="app.diagrams.net" modified="2026-10-08T00:00:00.000Z" agent="ChatGPT" version="24.0.0" type="device"><diagram name="4.3 Preprocessing and Partitioning: Recorded versus Recommended" id="03_Preprocessing_and_Split"><mxGraphModel dx="1200" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="960" pageHeight="820" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="raw" value="Raw ENNS records and observed FBS" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DDF4EE;strokeColor=#183153;fontColor=#263346;fontSize=15;fontStyle=1;align=center;verticalAlign=middle;arcSize=12;spacing=8;" vertex="1" parent="1"><mxGeometry x="300" y="36" width="340" height="64" as="geometry" /></mxCell><mxCell id="clean" value="Sentinel recoding · drop missing FBS&lt;br&gt;Feature engineering + label creation" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DDEBFA;strokeColor=#183153;fontColor=#263346;fontSize=15;fontStyle=1;align=center;verticalAlign=middle;arcSize=12;spacing=8;" vertex="1" parent="1"><mxGeometry x="300" y="132" width="340" height="76" as="geometry" /></mxCell><mxCell id="record" value="RECORDED V2 FLOW" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF0D9;strokeColor=#183153;fontColor=#263346;fontSize=15;fontStyle=1;align=center;verticalAlign=middle;arcSize=12;spacing=8;" vertex="1" parent="1"><mxGeometry x="30" y="253" width="380" height="48" as="geometry" /></mxCell><mxCell id="reco" value="LEAKAGE-SAFE FLOW (RECOMMENDED)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DDF4EE;strokeColor=#183153;fontColor=#263346;fontSize=15;fontStyle=1;align=center;verticalAlign=middle;arcSize=12;spacing=8;" vertex="1" parent="1"><mxGeometry x="510" y="253" width="400" height="48" as="geometry" /></mxCell><mxCell id="a" value="Imputation, IQR, scaling, feature filter&lt;br&gt;SMOTE on full preprocessed data" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE5